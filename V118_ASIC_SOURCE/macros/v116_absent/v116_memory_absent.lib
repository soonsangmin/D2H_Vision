     direction : input;
     capacitance : 0.002;
     pin (ADDR[12:0]) { }
   }
   bus (DATA) {
     bus_type : v116_bus96;
     direction : output;
     max_capacitance : 0.3;
     pin (DATA[95:0]) { }
   }
 }
